# Public URL of the deployed site (used for SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://blackowltattoo.mk

# ---- Booking form delivery ----
# Where booking requests are delivered
BOOKING_TO_EMAIL=studio@example.com
# Sender address (must be a verified domain/sender with your provider)
BOOKING_FROM_EMAIL="Black Owl Website <booking@blackowltattoo.mk>"

# Option A — Resend (https://resend.com). If set, Resend is used.
RESEND_API_KEY=

# Option B — any SMTP server (Gmail app password, Zoho, cPanel mailbox...)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
