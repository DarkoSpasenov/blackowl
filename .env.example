# Copy to .env.local for local builds. On GitHub Pages these are set as
# repository *Variables* (Settings → Secrets and variables → Actions → Variables).

# Public URL of the site, including the sub-folder if any (SEO: canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://darkospasenov.github.io/blackowl
# Sub-folder the site lives in ("" for a custom domain such as blackowltattoo.mk)
NEXT_PUBLIC_BASE_PATH=/blackowl

# Booking form delivery service — no server needed.
# Formspree: create a form at https://formspree.io, copy its endpoint here.
NEXT_PUBLIC_FORM_ENDPOINT=
# Set to "false" to hide the reference-image upload if your plan doesn't accept files
NEXT_PUBLIC_FORM_FILES=true
